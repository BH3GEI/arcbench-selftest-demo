# Copy to .env and adjust. docker compose reads this file automatically.
# Every value has an in-code default (server/app/config.py); nothing here is
# required to get the demo running, these are the knobs worth knowing about
# for an actual deployment.

# ---- Team auth (server/app/auth.py) ---------------------------------------
# SELFTEST_AUTH_MODE: token (default) | hmac | github | sso (bring your own, see auth.py)
SELFTEST_AUTH_MODE=token
# token mode: team=token pairs. Empty -> dev mode, the token IS the team id
# (only with SELFTEST_ALLOW_ANY_TOKEN=1; otherwise unconfigured = refused).
SELFTEST_TEAM_TOKENS=demo=demo-token
#SELFTEST_ALLOW_ANY_TOKEN=1
# hmac mode only: team=secret pairs. Token shape: team.timestamp.hex-hmac-sha256.
#SELFTEST_TEAM_SECRETS=demo=change-me-to-a-long-random-secret

# ---- GitHub OAuth login (auth_mode=github only) -----------------------------
# Quota/ownership key on the GitHub numeric account id — the same identity
# actions/web/'s NextAuth login uses, so a participant's daily quota means
# the same thing on both channels (docs/parity.md). Create the OAuth App at
# https://github.com/settings/applications/new with "Authorization callback
# URL" set to exactly SELFTEST_OAUTH_CALLBACK_URL below.
#GITHUB_OAUTH_CLIENT_ID=
#GITHUB_OAUTH_CLIENT_SECRET=
#SELFTEST_OAUTH_CALLBACK_URL=https://selftest.example.com/auth/github/callback
#SELFTEST_SESSION_SECRET=change-me-to-a-long-random-secret
#SELFTEST_SESSION_MAX_AGE_S=2592000
# Reject login for GitHub accounts younger than this; 0 disables.
#SELFTEST_MIN_ACCOUNT_AGE_DAYS=7

# ---- Quota ------------------------------------------------------------------
SELFTEST_DAILY_LIMIT=10

# ---- Task content -------------------------------------------------------
# <tasks_dir>/<task_id>/{requirements/requirements.yaml,tests/}, same shape
# the GitHub Actions grader reads (actions/README_ACTIONS.md).
SELFTEST_TASKS_DIR=./tasks
# Same directory as seen by the Docker *daemon* host (only differs from
# SELFTEST_TASKS_DIR when the server itself runs inside a container, e.g.
# under docker compose on a remote host — the daemon resolves sibling-
# container bind mounts against its own filesystem, not this container's).
SELFTEST_HOST_TASKS_DIR=./tasks

# ---- Submission limits ------------------------------------------------------
SELFTEST_MAX_ZIP_MB=50
SELFTEST_MAX_ZIP_FILES=2000

# ---- Job queue ----------------------------------------------------------
# How many submissions run concurrently (each build is serialized through
# this many worker threads; raise only alongside real CPU/memory headroom).
SELFTEST_JOB_WORKERS=1
# Submissions queued+running beyond this get HTTP 503, not an unbounded queue.
SELFTEST_JOB_QUEUE_MAX=100
# Finished submissions (zip, results, logs) older than this are deleted by an
# hourly sweep. 0 disables the sweep entirely (keep everything forever).
SELFTEST_RETENTION_HOURS=720

# ---- Isolation & resource limits for the SUBMITTED app ----------------------
SELFTEST_BUILD_NETWORK=none
# Build-time caps, enforced with a real subprocess kill on timeout, not just
# the server giving up on waiting for the build (docs/security-review.md #2).
SELFTEST_BUILD_MEM=1g
SELFTEST_BUILD_CPUS=2.0
SELFTEST_RUN_NETWORK_INTERNAL=1
SELFTEST_APP_MEM=512m
SELFTEST_APP_CPUS=1.0
SELFTEST_APP_PIDS=256
SELFTEST_APP_READ_ONLY=1

# ---- Runner image ---------------------------------------------------------
SELFTEST_RUNNER_IMAGE=selftest-runner:local
SELFTEST_RUNNER_CONTEXT_DIR=./runner

# ---- Logging --------------------------------------------------------------
# SELFTEST_LOG_FORMAT: text (default, human-readable) | json (one object/line)
SELFTEST_LOG_FORMAT=text
SELFTEST_LOG_LEVEL=INFO

# ---- TLS ------------------------------------------------------------------
# Set once a reverse proxy (deploy/Caddyfile, deploy/nginx.conf.example) that
# sets X-Forwarded-Proto is actually in front of this: rejects any request
# that arrives as plain HTTP and marks cookies Secure. Leave off for local
# HTTP-only dev.
SELFTEST_FORCE_HTTPS=0

# ---- Process role (server/app/config.py) ------------------------------------
# all (default): one process does HTTP + builds/runs submissions in-thread —
# fine for a single-container local/demo setup. Recommended for anything
# internet-facing: split into api (no Docker socket) + worker (has it, no
# exposed port) — see compose.yml, docs/security-review.md open item #1.
#SELFTEST_ROLE=all

# ---- Cleanup isolation ------------------------------------------------------
# Scopes the Docker label the startup janitor() sweeps, so two deployments
# sharing one Docker daemon can't clean up each other's in-flight containers.
# Defaults to this container's hostname; set explicitly for anything fancier
# (e.g. a fixed value per environment name).
#SELFTEST_LABEL=selftest.managed.prod

# ---- Alternate evaluator (INTEGRATION.md) -----------------------------------
#SELFTEST_EVALUATOR=arcbench
#SELFTEST_ARCBENCH_RUNNER_PATH=/opt/arcbench/run_submission.py
