# Copy to .env.local for local dev, or set the same names as Vercel project
# env vars for deployment. Never commit real values.

# --- GitHub OAuth App (participant login) ---
# Create at https://github.com/settings/applications/new — see
# README_ACTIONS.md "Web app" for exact Homepage/Callback URL values once
# the Vercel deployment URL is known. Placeholder values are fine until
# then; login simply won't work until these are real.
GITHUB_OAUTH_CLIENT_ID=placeholder
GITHUB_OAUTH_CLIENT_SECRET=placeholder

# NextAuth session encryption — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=placeholder
# Full deployed URL, e.g. https://arcbench-selftest-web.vercel.app
NEXTAUTH_URL=http://localhost:3000

# --- Grader repo access (server-side only, never sent to the browser) ---
# Fine-grained PAT scoped to just the private grader repo: contents:read
# (list tasks/) + the ability to call the dispatches API (classic PATs need
# `repo` scope for private-repo dispatch; fine-grained PATs need "Contents"
# read and the repo's Actions dispatch permission once GitHub exposes a
# narrower scope for it — see README_ACTIONS.md "Secrets & least privilege").
GRADER_SERVICE_TOKEN=placeholder
GRADER_REPO_OWNER=BH3GEI
GRADER_REPO_NAME=arcbench-grader-demo

# Same value as the grader repo's SELFTEST_DISPATCH_SIGNING_KEY secret —
# signs outbound dispatches, verifies inbound result callbacks.
SELFTEST_DISPATCH_SIGNING_KEY=placeholder

# --- Vercel-managed storage (auto-populated when KV/Blob stores are linked
# to the project; listed here only so local dev knows the var names) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=

# --- Watchdog cron (/api/cron/reconcile) ---
# Shared secret the trigger must send as `Authorization: Bearer <value>`.
# Generate with: openssl rand -base64 32. Empty disables the check (local
# dev only) — set it in production.
CRON_SECRET=placeholder

# --- Abuse prevention (all optional, sane defaults in lib/config.ts) ---
SELFTEST_WEB_DAILY_LIMIT_PER_USER=10
SELFTEST_WEB_DAILY_LIMIT_GLOBAL=200
SELFTEST_WEB_MAX_ZIP_MB=50
SELFTEST_WEB_MIN_ACCOUNT_AGE_DAYS=7

# --- Internal synthetic check (see README_ACTIONS.md "Internal synthetic
# check"). Unset = /api/internal/* always returns 403. Same value as the
# private ops repo's INTERNAL_CHECK_KEY Actions secret.
INTERNAL_CHECK_KEY=
